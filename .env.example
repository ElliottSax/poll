# ==============================================
# Polling Dashboard - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://poll_user:poll_password@localhost:5432/poll_db"
# For production: Use connection pooling
# DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=10"

# ==============================================
# REDIS
# ==============================================
REDIS_URL="redis://localhost:6379"
# For production with password:
# REDIS_URL="redis://:password@localhost:6379"

# ==============================================
# API SERVER
# ==============================================
API_PORT=3001
API_HOST="localhost"
NODE_ENV="development" # development | production | test
API_SECRET="change-this-to-a-random-secret-key-in-production"

# CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ==============================================
# FRONTEND (Next.js)
# ==============================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==============================================
# AUTHENTICATION (NextAuth.js)
# ==============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Twitter OAuth
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# GitHub OAuth
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# ==============================================
# MAPBOX (for maps)
# ==============================================
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# ==============================================
# STRIPE (payments)
# ==============================================
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_your-stripe-public-key"

# Stripe Price IDs
STRIPE_PRICE_PREMIUM_MONTHLY="price_premium_monthly_id"
STRIPE_PRICE_PREMIUM_YEARLY="price_premium_yearly_id"
STRIPE_PRICE_API_DEVELOPER="price_api_developer_id"
STRIPE_PRICE_API_PROFESSIONAL="price_api_professional_id"
STRIPE_PRICE_WIDGET_PRO="price_widget_pro_id"

# ==============================================
# EMAIL (SendGrid)
# ==============================================
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
FROM_EMAIL="noreply@pollingdashboard.com"
FROM_NAME="Polling Dashboard"

# ==============================================
# PYTHON ML SERVICE
# ==============================================
ML_SERVICE_URL="http://localhost:8000"
PYTHON_ENV="development"

# ==============================================
# ANALYTICS
# ==============================================
# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Plausible (privacy-friendly alternative)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="pollingdashboard.com"

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY="phc_your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ==============================================
# ERROR TRACKING (Sentry)
# ==============================================
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-org"
SENTRY_PROJECT="your-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ==============================================
# MONITORING
# ==============================================
# Datadog
DD_API_KEY="your-datadog-api-key"
DD_SITE="datadoghq.com"

# ==============================================
# OPENAI (for sentiment analysis)
# ==============================================
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_ORG_ID="org-your-org-id"

# ==============================================
# DATA SOURCES (optional commercial APIs)
# ==============================================
# TargetSmart (early vote data)
TARGETSMART_API_KEY="your-targetsmart-key"

# L2 Political (voter data)
L2_API_KEY="your-l2-api-key"

# News API (for news aggregation)
NEWS_API_KEY="your-news-api-key"

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# API Key Rate Limits (requests per day)
RATE_LIMIT_FREE=100
RATE_LIMIT_DEVELOPER=10000
RATE_LIMIT_PROFESSIONAL=100000
RATE_LIMIT_ENTERPRISE=999999999

# ==============================================
# CACHING
# ==============================================
CACHE_TTL_SHORT=60 # 1 minute
CACHE_TTL_MEDIUM=300 # 5 minutes
CACHE_TTL_LONG=3600 # 1 hour
CACHE_TTL_VERY_LONG=86400 # 24 hours

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL="info" # debug | info | warn | error
LOG_FORMAT="json" # json | pretty

# ==============================================
# SCRAPING
# ==============================================
# User agent for web scraping
USER_AGENT="PollingDashboard Bot/1.0 (+https://pollingdashboard.com/bot)"

# Scraping schedule (cron format)
SCRAPE_SCHEDULE_RCP="0 */6 * * *" # Every 6 hours
SCRAPE_SCHEDULE_538="0 */12 * * *" # Every 12 hours

# ==============================================
# FORECASTING MODEL
# ==============================================
FORECAST_SIMULATIONS=10000 # Number of Monte Carlo simulations
FORECAST_UPDATE_SCHEDULE="0 0 * * *" # Daily at midnight

# ==============================================
# FEATURE FLAGS
# ==============================================
FEATURE_PREDICTIONS_ENABLED=true
FEATURE_SCENARIOS_ENABLED=true
FEATURE_DEMOGRAPHICS_ENABLED=false
FEATURE_EARLY_VOTE_ENABLED=false
FEATURE_ELECTION_NIGHT_ENABLED=false

# ==============================================
# AWS (if using AWS services)
# ==============================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# S3 Bucket (for file storage)
AWS_S3_BUCKET="polling-dashboard-assets"

# ==============================================
# CLOUDFLARE
# ==============================================
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-zone-id"

# ==============================================
# DEVELOPMENT ONLY
# ==============================================
# Prisma Studio
PRISMA_STUDIO_PORT=5555

# Debug mode
DEBUG="app:*"

# Skip email verification in development
SKIP_EMAIL_VERIFICATION=true

# Mock external APIs in development
MOCK_EXTERNAL_APIS=false

# ==============================================
# TESTING
# ==============================================
# Test database (separate from development)
TEST_DATABASE_URL="postgresql://poll_user:poll_password@localhost:5432/poll_db_test"
TEST_REDIS_URL="redis://localhost:6379/1"

# ==============================================
# PRODUCTION ONLY
# ==============================================
# SSL/TLS
SSL_CERT_PATH="/etc/ssl/certs/polling-dashboard.crt"
SSL_KEY_PATH="/etc/ssl/private/polling-dashboard.key"

# CDN
CDN_URL="https://cdn.pollingdashboard.com"

# Session
SESSION_SECRET="production-session-secret-change-me"
SESSION_MAX_AGE=2592000000 # 30 days in milliseconds

# ==============================================
# NOTES
# ==============================================
# Generate secrets with:
#   openssl rand -base64 32
#
# Check .env is in .gitignore:
#   cat .gitignore | grep .env
#
# Validate environment variables on startup in:
#   - apps/web/lib/env.ts
#   - apps/api/src/config/env.ts
