// Polling Dashboard - Prisma Schema
// Database: PostgreSQL with TimescaleDB extension

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model Race {
  id          String   @id @default(uuid()) @db.Uuid
  raceType    RaceType @map("race_type")
  raceName    String   @map("race_name") @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)

  // Geography
  country     String   @default("USA") @db.VarChar(3)
  state       String?  @db.VarChar(2)
  district    String?  @db.VarChar(10)
  county      String?  @db.VarChar(100)

  // Timing
  electionDate      DateTime            @map("election_date") @db.Date
  isSpecialElection Boolean             @default(false) @map("is_special_election")

  // Candidates (flexible JSONB)
  candidates  Json     @db.JsonB

  // Status
  status           RaceStatus @default(UPCOMING)
  currentLeader    String?    @map("current_leader") @db.VarChar(255)
  competitiveRating String?   @map("competitive_rating") @db.VarChar(50)
  importanceScore  Int?       @map("importance_score") @db.SmallInt

  // Metadata
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  polls       Poll[]
  forecasts   Forecast[]
  results     Result[]

  @@index([raceType, state])
  @@index([electionDate])
  @@index([slug])
  @@index([status])
  @@map("races")
}

model Poll {
  id         String   @id @default(uuid()) @db.Uuid
  raceId     String   @map("race_id") @db.Uuid
  pollsterId String   @map("pollster_id") @db.Uuid

  // Timing
  pollDate   DateTime @map("poll_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Sample details
  sampleSize     Int?            @map("sample_size")
  methodology    PollMethodology?
  populationType PopulationType? @map("population_type")

  // Quality metrics
  partisanAffiliation String?  @map("partisan_affiliation") @db.VarChar(50)
  transparencyScore   Decimal? @map("transparency_score") @db.Decimal(3, 2)
  historicalAccuracy  Decimal? @map("historical_accuracy") @db.Decimal(5, 2)

  // Results (flexible JSONB for candidate results)
  results Json  @db.JsonB

  marginOfError Decimal? @map("margin_of_error") @db.Decimal(4, 2)

  // Source
  sourceUrl String? @map("source_url") @db.Text
  rawData   Json?   @map("raw_data") @db.JsonB

  // Relations
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  pollster  Pollster @relation(fields: [pollsterId], references: [id])

  @@index([raceId, pollDate(sort: Desc)])
  @@index([pollsterId])
  @@index([pollDate(sort: Desc)])
  @@map("polls")
}

model Pollster {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  // Organization
  organization String? @db.VarChar(255)
  website      String? @db.Text

  // Quality metrics
  overallAccuracy   Decimal? @map("overall_accuracy") @db.Decimal(5, 2)
  methodologyGrade  String?  @map("methodology_grade") @db.VarChar(2)
  transparencyScore Decimal? @map("transparency_score") @db.Decimal(3, 2)
  sampleSizeAvg     Int?     @map("sample_size_avg")

  // Bias metrics
  partisanLean String? @map("partisan_lean") @db.VarChar(50)
  houseEffect  Json?   @map("house_effect") @db.JsonB

  // Metadata
  pollCount     Int       @default(0) @map("poll_count")
  firstPollDate DateTime? @map("first_poll_date") @db.Date
  lastPollDate  DateTime? @map("last_poll_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  polls Poll[]

  @@index([slug])
  @@index([overallAccuracy(sort: Desc)])
  @@map("pollsters")
}

model Forecast {
  id      String   @id @default(uuid()) @db.Uuid
  raceId  String   @map("race_id") @db.Uuid

  // Timing
  forecastDate DateTime @map("forecast_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Model
  modelVersion String @map("model_version") @db.VarChar(50)

  // Predictions
  probabilities        Json @db.JsonB
  predictedMargins     Json @map("predicted_margins") @db.JsonB
  confidenceIntervals  Json @map("confidence_intervals") @db.JsonB

  // Simulation stats
  simulationsRun   Int     @map("simulations_run")
  volatilityIndex  Decimal @map("volatility_index") @db.Decimal(5, 2)

  // Contributing factors
  contributingPolls Int     @map("contributing_polls")
  pollQualityScore  Decimal @map("poll_quality_score") @db.Decimal(5, 2)

  // Notes
  notes String? @db.Text

  // Relations
  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, forecastDate(sort: Desc)])
  @@map("forecasts")
}

model Scenario {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  // Content
  title       String  @db.VarChar(255)
  description String? @db.Text

  // Adjustments
  pollAdjustments Json @map("poll_adjustments") @db.JsonB

  // Results
  electoralCollegeResult Json? @map("electoral_college_result") @db.JsonB
  senateResult           Json? @map("senate_result") @db.JsonB
  houseResult            Json? @map("house_result") @db.JsonB

  // Social
  views    Int     @default(0)
  likes    Int     @default(0)
  isPublic Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isPublic, views(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("scenarios")
}

model Result {
  id       String   @id @default(uuid()) @db.Uuid
  raceId   String   @map("race_id") @db.Uuid

  // Timing
  reportedAt DateTime @map("reported_at") @db.Timestamptz(3)

  // Location
  precinctId String? @map("precinct_id") @db.VarChar(100)
  county     String? @db.VarChar(100)

  // Vote counts
  votes Json @db.JsonB

  // Reporting metadata
  precinctsReporting Int?     @map("precincts_reporting")
  totalPrecincts     Int?     @map("total_precincts")
  percentReporting   Decimal? @map("percent_reporting") @db.Decimal(5, 2)

  // Estimates
  estimatedVotesRemaining Int? @map("estimated_votes_remaining")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, reportedAt(sort: Desc)])
  @@map("results")
}

model Alert {
  id     String @id @default(uuid()) @db.Uuid
  raceId String @map("race_id") @db.Uuid

  // Alert content
  alertType AlertType @map("alert_type")
  message   String    @db.Text

  // Change details
  oldValue  String?  @map("old_value") @db.VarChar(100)
  newValue  String?  @map("new_value") @db.VarChar(100)
  magnitude Decimal? @db.Decimal(5, 2)

  // Distribution
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  // Targeting
  minImportance Int? @map("min_importance") @db.SmallInt

  @@index([raceId, createdAt(sort: Desc)])
  @@index([sentAt])
  @@map("alerts")
}

// ============================================
// USER MODELS
// ============================================

model User {
  id String @id @default(uuid()) @db.Uuid

  // Auth
  email        String  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.Text

  // OAuth
  googleId  String? @unique @map("google_id") @db.VarChar(255)
  twitterId String? @unique @map("twitter_id") @db.VarChar(255)
  githubId  String? @unique @map("github_id") @db.VarChar(255)

  // Profile
  username    String? @unique @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(255)
  avatarUrl   String? @map("avatar_url") @db.Text

  // Preferences
  trackedRaces             String[] @map("tracked_races") @db.Uuid
  notificationPreferences  Json?    @map("notification_preferences") @db.JsonB

  // Gamification
  predictionScore     Int @default(0) @map("prediction_score")
  correctPredictions  Int @default(0) @map("correct_predictions")
  totalPredictions    Int @default(0) @map("total_predictions")

  // Metadata
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLogin DateTime? @map("last_login") @db.Timestamptz(3)

  // Permissions
  role       UserRole @default(USER)
  isVerified Boolean  @default(false) @map("is_verified")

  // Relations
  scenarios    Scenario[]
  predictions  Prediction[]
  apiKeys      ApiKey[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Prediction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  raceId String @map("race_id") @db.Uuid

  // Prediction
  predictedWinner String  @map("predicted_winner") @db.VarChar(255)
  predictedMargin Decimal @map("predicted_margin") @db.Decimal(5, 2)
  confidence      Int     @db.SmallInt // 1-100

  // Wager (virtual currency)
  pointsWagered Int @map("points_wagered")

  // Locking
  lockedAt DateTime @map("locked_at") @db.Timestamptz(3)

  // Scoring
  isCorrect    Boolean?  @map("is_correct")
  pointsEarned Int?      @map("points_earned")
  scoredAt     DateTime? @map("scored_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, raceId])
  @@index([userId])
  @@index([isCorrect])
  @@map("predictions")
}

model ApiKey {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Key
  key    String   @unique @db.VarChar(64)
  name   String   @db.VarChar(255)

  // Tier
  tier ApiTier

  // Usage tracking
  requestCount Int      @default(0) @map("request_count")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  // Status
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

// ============================================
// ENUMS
// ============================================

enum RaceType {
  PRESIDENT
  SENATE
  HOUSE
  GOVERNOR
  MAYOR
  STATE_LEG
  OTHER
}

enum RaceStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PollMethodology {
  PHONE
  ONLINE
  IVR
  MIXED
  IN_PERSON
  OTHER
}

enum PopulationType {
  RV  // Registered Voters
  LV  // Likely Voters
  A   // Adults
  V   // Voters
}

enum AlertType {
  NEW_POLL
  RATING_CHANGE
  FORECAST_SHIFT
  RESULT_UPDATE
  MAJOR_MOVEMENT
}

enum UserRole {
  USER
  ANALYST
  ADMIN
}

enum ApiTier {
  FREE
  DEVELOPER
  PROFESSIONAL
  ENTERPRISE
}
