# UltraThink Production Configuration
# Advanced Polling Analytics Platform

# Application
NODE_ENV=production
PORT=3000
API_PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/polling_db
REDIS_URL=redis://localhost:6379

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# UltraThink Engine Configuration
ULTRATHINK_MODE=production
ULTRATHINK_MODEL_TYPE=advanced
ULTRATHINK_CACHE_TTL=3600
ULTRATHINK_MAX_WORKERS=4
ULTRATHINK_PREDICTION_HORIZON=30
ULTRATHINK_CONFIDENCE_THRESHOLD=0.75

# Monitoring
ENABLE_TELEMETRY=false
LOG_LEVEL=info
SENTRY_DSN=

# Performance
ENABLE_CACHE=true
CACHE_TTL=300
MAX_CONNECTIONS=100

# Security
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# ML/AI Features
ML_API_ENDPOINT=http://localhost:5000
ML_MODEL_VERSION=1.0.0
ENABLE_QUANTUM_MODE=true